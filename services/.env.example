# Copy to .env (never commit .env) and fill in.

# Shared secret Salesforce sends to the credit scoring service (same value as the ApiKey
# parameter of the Credit_Scoring external credential)
SCORING_API_KEY=dev-key

# PostgreSQL password for all services
DB_PASSWORD=scoring

# Event bridge: External Client App with the client credentials flow (see event-bridge/README.md)
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Server only (docker-compose.prod.yml): the public host name Caddy gets a certificate for.
# With no domain, use the VM's IP with dashes on sslip.io.
PUBLIC_HOST=84-13-65-218.sslip.io

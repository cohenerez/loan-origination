<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_In_Range</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Term_Months__c)), OR(Term_Months__c &lt; 6, Term_Months__c &gt; 360))</errorConditionFormula>
    <errorDisplayField>Term_Months__c</errorDisplayField>
    <errorMessage>Term must be between 6 and 360 months.</errorMessage>
</ValidationRule>
